Track(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed and not WaitingForKeybind then return end
    if gameProcessed and WaitingForKeybind and input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if input.KeyCode == Enum.KeyCode.RightShift then
        GuiVisible = not GuiVisible
        if MainFrame then MainFrame.Visible = GuiVisible end
        return
    end

    if WaitingForKeybind and input.KeyCode ~= Enum.KeyCode.Unknown then
        local key = input.KeyCode
        local action = WaitingForKeybindAction
        local button = WaitingForKeybindButton
        if key == Enum.KeyCode.RightShift then
            print("❌ Cannot bind Right Shift")
            if button then
                local displayName = action:gsub("Toggle", ""):gsub("TeleportToTarget", "Teleport"):gsub("BringTarget", "Bring"):gsub("RapidFire", "Rapid Fire"):gsub("WallBang", "WallBang"):gsub("SnapAim", "Snap Aim"):gsub("SuperFast", "Super Fast")
                button.Text = displayName .. ": " .. (Keybinds[action] and KeyCodeToString(Keybinds[action]) or "None")
                button.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            end
            WaitingForKeybind = false
            WaitingForKeybindAction = nil
            WaitingForKeybindButton = nil
            return
        end
        Keybinds[action] = key
        Settings["Keybind_" .. action] = KeyCodeToString(key)
        SaveSettings()
        if button then
            local displayName = action:gsub("Toggle", ""):gsub("TeleportToTarget", "Teleport"):gsub("BringTarget", "Bring"):gsub("RapidFire", "Rapid Fire"):gsub("WallBang", "WallBang"):gsub("SnapAim", "Snap Aim"):gsub("SuperFast", "Super Fast")
            button.Text = displayName .. ": " .. KeyCodeToString(key)
            button.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        end
        print("✅ Bound " .. action .. " to " .. KeyCodeToString(key))
        WaitingForKeybind = false
        WaitingForKeybindAction = nil
        WaitingForKeybindButton = nil
        return
    end

    if Keybinds.ToggleAimbot and input.KeyCode == Keybinds.ToggleAimbot and not KeybindDebounce.ToggleAimbot then
        KeybindDebounce.ToggleAimbot = true ToggleAimbot()
        task.delay(0.2, function() KeybindDebounce.ToggleAimbot = false end) return
    end
    if Keybinds.ToggleFly and input.KeyCode == Keybinds.ToggleFly and not KeybindDebounce.ToggleFly then
        KeybindDebounce.ToggleFly = true ToggleFly()
        task.delay(0.2, function() KeybindDebounce.ToggleFly = false end) return
    end
    if Keybinds.ToggleNoclip and input.KeyCode == Keybinds.ToggleNoclip and not KeybindDebounce.ToggleNoclip then
        KeybindDebounce.ToggleNoclip = true ToggleNoclip()
        task.delay(0.2, function() KeybindDebounce.ToggleNoclip = false end) return
    end
    if Keybinds.ToggleESP and input.KeyCode == Keybinds.ToggleESP and not KeybindDebounce.ToggleESP then
        KeybindDebounce.ToggleESP = true ToggleESP()
        task.delay(0.2, function() KeybindDebounce.ToggleESP = false end) return
    end
    if Keybinds.ToggleRapidFire and input.KeyCode == Keybinds.ToggleRapidFire and not KeybindDebounce.ToggleRapidFire then
        KeybindDebounce.ToggleRapidFire = true ToggleRapidFire()
        task.delay(0.2, function() KeybindDebounce.ToggleRapidFire = false end) return
    end
    if Keybinds.ToggleSuperFast and input.KeyCode == Keybinds.ToggleSuperFast and not KeybindDebounce.ToggleSuperFast then
        KeybindDebounce.ToggleSuperFast = true ToggleSuperFastShoot()
        task.delay(0.2, function() KeybindDebounce.ToggleSuperFast = false end) return
    end
    if Keybinds.ToggleAttach and input.KeyCode == Keybinds.ToggleAttach and not KeybindDebounce.ToggleAttach then
        KeybindDebounce.ToggleAttach = true ToggleAttach()
        task.delay(0.3, function() KeybindDebounce.ToggleAttach = false end) return
    end
    if Keybinds.ToggleWallBang and input.KeyCode == Keybinds.ToggleWallBang and not KeybindDebounce.ToggleWallBang then
        KeybindDebounce.ToggleWallBang = true ToggleWallBang()
        task.delay(0.3, function() KeybindDebounce.ToggleWallBang = false end) return
    end
    if Keybinds.ToggleSnapAim and input.KeyCode == Keybinds.ToggleSnapAim and not KeybindDebounce.ToggleSnapAim then
        KeybindDebounce.ToggleSnapAim = true ToggleSnapAim()
        task.delay(0.3, function() KeybindDebounce.ToggleSnapAim = false end) return
    end
    if Keybinds.TeleportToTarget and input.KeyCode == Keybinds.TeleportToTarget and lockedTarget and not KeybindDebounce.TeleportToTarget then
        KeybindDebounce.TeleportToTarget = true TeleportToPlayer(lockedTarget)
        task.delay(0.3, function() KeybindDebounce.TeleportToTarget = false end) return
    end
    if Keybinds.BringTarget and input.KeyCode == Keybinds.BringTarget and lockedTarget and not KeybindDebounce.BringTarget then
        KeybindDebounce.BringTarget = true BringPlayer(lockedTarget)
        task.delay(0.3, function() KeybindDebounce.BringTarget = false end) return
    end
end))

