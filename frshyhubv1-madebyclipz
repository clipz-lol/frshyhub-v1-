                else AttachToPlayer(player) end
                task.wait(0.1)
                UpdateAttachList()
            end)
            table.insert(AttachButtons, Button)
            yPos = yPos + 28
        end
        AttachListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 5)
    end
    getgenv().UpdateAttachList = UpdateAttachList

    AttachSearchBar:GetPropertyChangedSignal("Text"):Connect(function()
        AttachSearchQuery = AttachSearchBar.Text
        UpdateAttachList()
    end)

    SaveStatusLabel = Instance.new("TextLabel")
