local function ApplyThemeFromPreset(presetName)
    local preset = ThemePresets[presetName]
    if not preset then return false end
    Theme.AccentColor     = preset.Accent
    Theme.BackgroundColor = preset.Background
    Theme.PanelColor      = preset.Panel
    Theme.TextColor       = preset.Text
    Theme.TitleColor      = preset.Title
    Theme.HeaderColor     = preset.Header
    Theme.PresetName      = presetName
    Settings.ThemePreset     = presetName
    Settings.ThemeAccent     = preset.Accent
    Settings.ThemeBackground = preset.Background
    Settings.ThemePanel      = preset.Panel
    Settings.ThemeText       = preset.Text
    Settings.ThemeTitle      = preset.Title
    Settings.ThemeHeader     = preset.Header
    SaveSettings()
    if ApplyThemeToGUI then ApplyThemeToGUI() end
    return true
end

local function ParseColorInput(text, fallback)
    local parts = {}
    for part in string.gmatch(text, "[^,]+") do
        table.insert(parts, tonumber(part))
    end
    if #parts == 3 then
        return {
            math.clamp(math.floor(parts[1] or 0), 0, 255),
            math.clamp(math.floor(parts[2] or 0), 0, 255),
            math.clamp(math.floor(parts[3] or 0), 0, 255)
        }
    end
    return fallback
end

