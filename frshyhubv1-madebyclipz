Track(RunService.RenderStepped:Connect(function()
    if FOVCircle then
        local size = getgenv().AimFOV * 2
        FOVCircle.Size = UDim2.new(0, size, 0, size)
        FOVCircle.Position = UDim2.new(0.5, -getgenv().AimFOV, 0.5, -getgenv().AimFOV)
        FOVCircle.Visible = getgenv().ShowFOV
        local color = Color3.fromRGB(Settings.FOVColor[1], Settings.FOVColor[2], Settings.FOVColor[3])
        FOVCircle.BackgroundColor3 = color
        FOVCircle.BorderColor3 = color
        FOVCircle.BorderSizePixel = Settings.FOVBorderSize or 2
        FOVCircle.BackgroundTransparency = Settings.FOVTransparency
    end
    Fly()
    Noclip()

    if getgenv().AimbotEnabled then
        local target = GetBestTarget()
        if target and target.ScreenPos then
            local mousePos = UserInputService:GetMouseLocation()
            local deltaX = target.ScreenX - mousePos.X
            local deltaY = target.ScreenY - mousePos.Y

            local lockStrength = getgenv().AimLockStrength or 1.0
            local smoothness = getgenv().Smoothness or 100

            local hardLock = getgenv().SnapAimEnabled or (lockStrength >= 0.95)

            if hardLock then
                if math.abs(deltaX) > 0.05 or math.abs(deltaY) > 0.05 then
                    mousemoverel(deltaX, deltaY)
                end
            else
                local smoothFactor = smoothness / 100
                local strengthFactor = 0.03 + (lockStrength * 0.97)
                local effectiveFactor = strengthFactor * (1 - smoothFactor * 0.97)
                effectiveFactor = math.clamp(effectiveFactor, 0.03, 1.0)

                local moveX = deltaX * effectiveFactor
                local moveY = deltaY * effectiveFactor

                if math.abs(deltaX) < 2 and math.abs(deltaY) < 2 then
                    moveX = deltaX
                    moveY = deltaY
                end

                if math.abs(moveX) > 0.01 or math.abs(moveY) > 0.01 then
                    mousemoverel(moveX, moveY)
                end
            end
        else
            lockedTarget = nil
        end
    else
        lockedTarget = nil
    end
end))

