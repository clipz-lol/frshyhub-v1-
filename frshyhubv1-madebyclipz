            Button.TextColor3 = isAttached and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(150, 200, 200)
            Button.BackgroundColor3 = isAttached and Color3.fromRGB(0, 40, 40) or Color3.fromRGB(10, 20, 20)
            Button.Font = Enum.Font.Gotham
            Button.TextSize = 13
            Button.TextXAlignment = Enum.TextXAlignment.Left
            Button.Parent = AttachListFrame
            Button.BorderSizePixel = 1
            Button.BorderColor3 = isAttached and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(0, 80, 80)
            Button.MouseButton1Click:Connect(function()
