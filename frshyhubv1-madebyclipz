-- ============================================
-- FLY / NOCLIP
-- ============================================

local function Fly()
    if not getgenv().FlyEnabled then
        if flyRunning then
            flyRunning = false
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand = false end
        end
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")
    if not hrp or not humanoid then return end
    flyRunning = true
    humanoid.PlatformStand = true
    local movement = Vector3.new(0, 0, 0)
    local camCF = Camera.CFrame
    local forward = camCF.LookVector * Vector3.new(1, 0, 1)
    local right = camCF.RightVector * Vector3.new(1, 0, 1)
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then movement = movement + forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then movement = movement - forward end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then movement = movement - right end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then movement = movement + right end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then movement = movement + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then movement = movement - Vector3.new(0, 1, 0) end
    if movement.Magnitude > 0 then movement = movement.Unit * getgenv().FlySpeed end
    hrp.Velocity = movement
end

local function Noclip()
    local enabled = getgenv().NoclipEnabled
    if noclipActive == enabled then return end
    noclipActive = enabled
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = not enabled end
    end
end

local function IsEnemy(player)
    if not player or player == LocalPlayer then return false end
    if not getgenv().TeamCheck then return true end
    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then return false end
    return true
end

local function IsPlayerVisible(player)
    if not player or not player.Character then return false end
    local targetPart = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local distance = direction.Magnitude
    direction = direction.Unit
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction * distance, params)
    if not result then return true end
    if result.Instance and result.Instance:IsDescendantOf(player.Character) then return true end
    return false
end

local function GetTargetPosition(player)
    if not player or not player.Character then return nil end
    local head = player.Character:FindFirstChild("Head") or player.Character:FindFirstChild("HumanoidRootPart")
    if not head then return nil end
    local velocity = Vector3.new(0, 0, 0)
    local root = player.Character:FindFirstChild("HumanoidRootPart")
    if root then velocity = root.Velocity end
    return head.Position + (velocity * (getgenv().Prediction or 0))
end

local function IsValidTarget(player)
    if not player then return false end
    if player == LocalPlayer then return false end
    if not player.Character then return false end
    if getgenv().FriendProtection and IsProtected(player) then return false end
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if not IsEnemy(player) then return false end
    return true
end

local function GetBestTarget()
    if not getgenv().AimbotEnabled then return nil end
    local mousePos = UserInputService:GetMouseLocation()
    local fov = getgenv().AimFOV
    local wallCheck = getgenv().WallCheck
    if getgenv().WallBangEnabled then wallCheck = false end
    if lockedTarget and IsValidTarget(lockedTarget) then
        local targetPos = GetTargetPosition(lockedTarget)
        if targetPos then
            if not (wallCheck and not IsPlayerVisible(lockedTarget)) then
                local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                    local maxTrackDist = fov * 1.5
                    if getgenv().SnapAimEnabled or getgenv().AimLockStrength >= 0.95 then
                        maxTrackDist = fov * 3
                    end
                    if dist < maxTrackDist then
                        return {Position = targetPos, ScreenPos = screenPos, Player = lockedTarget, ScreenX = screenPos.X, ScreenY = screenPos.Y}
                    else lockedTarget = nil end
                end
            else lockedTarget = nil end
        else lockedTarget = nil end
    end
    local sorted = {}
    for _, player in pairs(Players:GetPlayers()) do
        if IsValidTarget(player) then
            local targetPos = GetTargetPosition(player)
            if targetPos then
                if not (wallCheck and not IsPlayerVisible(player)) then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if dist < fov then
                            table.insert(sorted, {player = player, targetPos = targetPos, screenPos = screenPos, distance = dist})
                        end
                    end
                end
            end
        end
    end
    table.sort(sorted, function(a, b) return a.distance < b.distance end)
    if #sorted > 0 then
        local best = sorted[1]
        lockedTarget = best.player
        return {Position = best.targetPos, ScreenPos = best.screenPos, Player = best.player, ScreenX = best.screenPos.X, ScreenY = best.screenPos.Y}
    end
    lockedTarget = nil
    return nil
end

