local ESPDrawings = {}
local ESPConnection = nil

local function CleanupESP(player)
    if ESPDrawings[player] then
        for _, drawing in pairs(ESPDrawings[player]) do
            pcall(function() drawing:Remove() end)
        end
        ESPDrawings[player] = nil
    end
end

local function CleanupAllESP()
    for player, _ in pairs(ESPDrawings) do CleanupESP(player) end
    ESPDrawings = {}
end

local function GetESPColor(player)
    if Settings.ESPColorMode == "Health" then
        local humanoid = player.Character and player.Character:FindFirstChild("Humanoid")
        if humanoid then
            local hp = humanoid.Health / humanoid.MaxHealth
            if hp > 0.75 then return Color3.fromRGB(0, 255, 0)
            elseif hp > 0.5 then return Color3.fromRGB(255, 255, 0)
            elseif hp > 0.25 then return Color3.fromRGB(255, 150, 0)
            else return Color3.fromRGB(255, 0, 0) end
        end
        return Color3.fromRGB(255, 255, 255)
    elseif Settings.ESPColorMode == "Custom" then
        return Color3.fromRGB(Settings.ESPCustomColor[1], Settings.ESPCustomColor[2], Settings.ESPCustomColor[3])
    else
        if player.Team and LocalPlayer.Team then
            if player.Team == LocalPlayer.Team then return Color3.fromRGB(0, 255, 0)
            else return Color3.fromRGB(255, 0, 0) end
        end
        return Color3.fromRGB(255, 255, 255)
    end
end

local function ShouldESP(player)
    if not Settings.ESPEnabled then return false end
    if player == LocalPlayer and not Settings.ESPShowLocal then return false end
    if not player.Character then return false end
    local humanoid = player.Character:FindFirstChild("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    if Settings.ESPFriendCheck and IsProtected(player) then return false end
    if Settings.ESPTeamCheck and player.Team and LocalPlayer.Team then
        if player.Team == LocalPlayer.Team then return false end
    end
    return true
end

local function CreateESP(player)
    if ESPDrawings[player] then return end
    local drawings = {}
    
    if Settings.ESPBox then
        drawings.Box = Drawing.new("Square")
        drawings.Box.Thickness = Settings.ESPBoxThickness
        drawings.Box.Filled = false
        drawings.Box.Transparency = 1
        drawings.Box.Visible = false
    end
    if Settings.ESPName then
        drawings.Name = Drawing.new("Text")
        drawings.Name.Size = Settings.ESPTextSize
        drawings.Name.Center = true
        drawings.Name.Outline = true
        drawings.Name.OutlineColor = Color3.fromRGB(0, 0, 0)
        drawings.Name.Visible = false
    end
    if Settings.ESPHealth then
        drawings.HealthBar = Drawing.new("Line")
        drawings.HealthBar.Thickness = 2
        drawings.HealthBar.Visible = false
        drawings.HealthBarBG = Drawing.new("Line")
        drawings.HealthBarBG.Thickness = 2
        drawings.HealthBarBG.Color = Color3.fromRGB(0, 0, 0)
        drawings.HealthBarBG.Visible = false
    end
    if Settings.ESPDistance then
        drawings.Distance = Drawing.new("Text")
        drawings.Distance.Size = Settings.ESPTextSize - 2
        drawings.Distance.Center = true
        drawings.Distance.Outline = true
        drawings.Distance.OutlineColor = Color3.fromRGB(0, 0, 0)
        drawings.Distance.Visible = false
    end
    if Settings.ESPSkeleton then
        for _, name in ipairs({"SkeletonHead","SkeletonTorso","SkeletonLeftArm","SkeletonRightArm","SkeletonLeftLeg","SkeletonRightLeg"}) do
            drawings[name] = Drawing.new("Line")
            drawings[name].Thickness = 1
            drawings[name].Visible = false
        end
    end
    
    ESPDrawings[player] = drawings
end

local function UpdateESP(player)
    local drawings = ESPDrawings[player]
    if not drawings then return end
    
    if not ShouldESP(player) then
        for _, d in pairs(drawings) do pcall(function() d.Visible = false end) end
        return
    end
    
    local character = player.Character
    if not character then
        for _, d in pairs(drawings) do pcall(function() d.Visible = false end) end
        return
    end
    
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChild("Humanoid")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    
    if not head or not hrp then
        for _, d in pairs(drawings) do pcall(function() d.Visible = false end) end
        return
    end
    
    local headPos, onScreen1 = Camera:WorldToViewportPoint(head.Position)
    local rootPos, onScreen2 = Camera:WorldToViewportPoint(hrp.Position)
    
    if not onScreen1 and not onScreen2 then
        for _, d in pairs(drawings) do pcall(function() d.Visible = false end) end
        return
    end
    
    local color = GetESPColor(player)
    local boxHeight = math.abs(headPos.Y - rootPos.Y) * 1.5
    local boxWidth = boxHeight * 0.6
    local boxX = headPos.X - boxWidth / 2
    local boxY = headPos.Y - boxHeight * 0.15
    
    if drawings.Box then
        drawings.Box.Size = Vector2.new(boxWidth, boxHeight)
        drawings.Box.Position = Vector2.new(boxX, boxY)
        drawings.Box.Color = color
        drawings.Box.Thickness = Settings.ESPBoxThickness
        drawings.Box.Visible = true
    end
    
    if drawings.Name then
        drawings.Name.Text = player.Name
        drawings.Name.Position = Vector2.new(headPos.X, boxY - 18)
        drawings.Name.Color = color
        drawings.Name.Size = Settings.ESPTextSize
        drawings.Name.Visible = true
    end
    
    if drawings.HealthBar and humanoid then
        local hp = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
        local barX = boxX - 8
        drawings.HealthBarBG.From = Vector2.new(barX, boxY)
        drawings.HealthBarBG.To = Vector2.new(barX, boxY + boxHeight)
        drawings.HealthBarBG.Visible = true
        drawings.HealthBar.From = Vector2.new(barX, boxY + boxHeight * (1 - hp))
        drawings.HealthBar.To = Vector2.new(barX, boxY + boxHeight)
        drawings.HealthBar.Color = Color3.fromRGB(255 * (1 - hp), 255 * hp, 0)
        drawings.HealthBar.Visible = true
    end
    
    if drawings.Distance then
        local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
        drawings.Distance.Text = math.floor(dist) .. " studs"
        drawings.Distance.Position = Vector2.new(headPos.X, boxY + boxHeight + 2)
        drawings.Distance.Color = color
        drawings.Distance.Size = Settings.ESPTextSize - 2
        drawings.Distance.Visible = true
    end
    
    if Settings.ESPSkeleton then
        local function getPos(partName)
            local part = character:FindFirstChild(partName)
            if part then
                local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then return Vector2.new(pos.X, pos.Y) end
            end
            return nil
        end
        local headS = getPos("Head")
        local upperTorso = getPos("UpperTorso") or getPos("Torso")
        local lowerTorso = getPos("LowerTorso") or getPos("Torso")
        local leftArm = getPos("LeftHand") or getPos("Left Arm")
        local rightArm = getPos("RightHand") or getPos("Right Arm")
        local leftLeg = getPos("LeftFoot") or getPos("Left Leg")
        local rightLeg = getPos("RightFoot") or getPos("Right Leg")
        
        local function setLine(name, from, to)
            if drawings[name] then
                if from and to then
                    drawings[name].From = from
                    drawings[name].To = to
                    drawings[name].Color = color
                    drawings[name].Visible = true
                else
                    drawings[name].Visible = false
                end
            end
        end
        
        setLine("SkeletonHead", headS, upperTorso)
        setLine("SkeletonTorso", upperTorso, lowerTorso)
        setLine("SkeletonLeftArm", upperTorso, leftArm)
        setLine("SkeletonRightArm", upperTorso, rightArm)
        setLine("SkeletonLeftLeg", lowerTorso, leftLeg)
        setLine("SkeletonRightLeg", lowerTorso, rightLeg)
    end
end

local function UpdateAllESP()
    if not Settings.ESPEnabled then
        for _, drawings in pairs(ESPDrawings) do
            for _, d in pairs(drawings) do pcall(function() d.Visible = false end) end
        end
        return
    end
    for _, player in pairs(Players:GetPlayers()) do
        if ShouldESP(player) then
            if not ESPDrawings[player] then CreateESP(player) end
            UpdateESP(player)
        else
            if ESPDrawings[player] then
                for _, d in pairs(ESPDrawings[player]) do pcall(function() d.Visible = false end) end
            end
        end
    end
end

local function StartESP()
    if ESPConnection then return end
    ESPConnection = RunService.RenderStepped:Connect(UpdateAllESP)
end

local function StopESP()
    if ESPConnection then
        ESPConnection:Disconnect()
        ESPConnection = nil
    end
    for _, drawings in pairs(ESPDrawings) do
        for _, d in pairs(drawings) do pcall(function() d.Visible = false end) end
    end
end

