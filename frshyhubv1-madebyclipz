-- ATTACH
-- ============================================

local AttachConnection = nil
local AttachTargetPlayer = nil
local OriginalWalkSpeed = 16
local OriginalJumpPower = 50
local OriginalJumpHeight = 7.2
local AttachActive = false

local function GetAttachOffset()
    return CFrame.new(Settings.AttachOffsetX or 0, Settings.AttachOffsetY or 2, Settings.AttachOffsetZ or 3)
end

local function DetachFromPlayer()
    if AttachConnection then AttachConnection:Disconnect() AttachConnection = nil end
    AttachTargetPlayer = nil
    Settings.AttachTarget = nil
    AttachActive = false
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.WalkSpeed = OriginalWalkSpeed
            if humanoid.UseJumpPower then humanoid.JumpPower = OriginalJumpPower
            else humanoid.JumpHeight = OriginalJumpHeight end
        end
        if hrp then hrp.Anchored = false hrp.Velocity = Vector3.new(0, 0, 0) end
    end
    print("🔗 Detached from player")
    if SaveStatusLabel then
        SaveStatusLabel.Text = "🔗 Detached"
        SaveStatusLabel.TextColor3 = Color3.fromRGB(255, 150, 50)
        SaveStatusLabel.Visible = true
        task.delay(1.5, function() if SaveStatusLabel then SaveStatusLabel.Visible = false end end)
    end
    if UpdateAllTabButtons then UpdateAllTabButtons() end
    if getgenv().UpdateAttachStatus then getgenv().UpdateAttachStatus() end
    if getgenv().UpdateAttachList then getgenv().UpdateAttachList() end
end

local function AttachToPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then print("❌ No target!") return false end
    local targetHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetHrp then print("❌ Target has no HRP!") return false end
    local char = LocalPlayer.Character
    if not char then print("❌ You have no character!") return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then print("❌ Missing HRP or Humanoid!") return false end
    if AttachConnection then AttachConnection:Disconnect() AttachConnection = nil end
    OriginalWalkSpeed = humanoid.WalkSpeed
    OriginalJumpPower = humanoid.JumpPower
    OriginalJumpHeight = humanoid.JumpHeight
    AttachTargetPlayer = targetPlayer
    Settings.AttachTarget = targetPlayer.Name
    AttachActive = true
    humanoid.PlatformStand = true
    humanoid.WalkSpeed = 0
    AttachConnection = RunService.RenderStepped:Connect(function()
        if not AttachActive then return end
        if not AttachTargetPlayer or not AttachTargetPlayer.Character then DetachFromPlayer() return end
        local tHrp = AttachTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myChar = LocalPlayer.Character
        if not myChar then return end
        local myHrp = myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then return end
        if not tHrp then DetachFromPlayer() return end
        local offset = GetAttachOffset()
        local targetCF = tHrp.CFrame
        if Settings.AttachLockRotation then myHrp.CFrame = targetCF * offset
        else myHrp.CFrame = CFrame.new(targetCF * offset) * (myHrp.CFrame - myHrp.CFrame.Position) end
    end)
    print("🔗 Attached to " .. targetPlayer.Name)
    if SaveStatusLabel then
        SaveStatusLabel.Text = "🔗 Attached to " .. targetPlayer.Name
        SaveStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 200)
        SaveStatusLabel.Visible = true
        task.delay(1.5, function() if SaveStatusLabel then SaveStatusLabel.Visible = false end end)
    end
    if UpdateAllTabButtons then UpdateAllTabButtons() end
    if getgenv().UpdateAttachStatus then getgenv().UpdateAttachStatus() end
    if getgenv().UpdateAttachList then getgenv().UpdateAttachList() end
    return true
end

local function ToggleAttach()
    if AttachActive then DetachFromPlayer()
    else
        local target = AttachTargetPlayer
        if not target or not target.Character then
            local closest, dist = nil, math.huge
            local myChar = LocalPlayer.Character
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local myPos = myChar.HumanoidRootPart.Position
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        if not (getgenv().FriendProtection and IsProtected(p)) then
                            local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
                            if d < dist then closest, dist = p, d end
                        end
                    end
                end
            end
            target = closest
        end
        if target then AttachToPlayer(target)
        else
            print("❌ No valid player nearby")
            if SaveStatusLabel then
                SaveStatusLabel.Text = "❌ No target found"
                SaveStatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                SaveStatusLabel.Visible = true
                task.delay(1.5, function() if SaveStatusLabel then SaveStatusLabel.Visible = false end end)
            end
        end
    end
end

