-- ============================================

local function TeleportToPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then print("❌ No character!") return false end
    local character = LocalPlayer.Character
    if not character then return false end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end
    local pos = targetRoot.Position + Vector3.new(0, 2, 0)
    local tween = TweenService:Create(hrp, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = CFrame.new(pos)})
    tween:Play()
    tween.Completed:Wait()
    print("✅ Teleported to " .. targetPlayer.Name)
    return true
end

local function BringPlayer(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then print("❌ No character!") return false end
    local character = LocalPlayer.Character
    if not character then return false end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return false end
    local pos = hrp.Position + Vector3.new(0, 2, 0)
    local tween = TweenService:Create(targetRoot, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {CFrame = CFrame.new(pos)})
    tween:Play()
    tween.Completed:Wait()
    print("✅ Brought " .. targetPlayer.Name)
    return true
end

-- ============================================
-- RAPID FIRE
-- ============================================

local RapidFireRunning = false
local RapidFireConnection = nil
local RapidFireLastFireTime = 0

local function FireGun()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(Vector2.new(0, 0), 0, true, Enum.UserInputType.MouseButton1, 0)
        VirtualInputManager:SendMouseButtonEvent(Vector2.new(0, 0), 0, false, Enum.UserInputType.MouseButton1, 0)
    end)
end

local function StartRapidFire()
    if RapidFireRunning then return end
    if not getgenv().RapidFireEnabled then return end
    RapidFireRunning = true
    RapidFireLastFireTime = 0
    print("🔫 Rapid Fire ENABLED")
    local fireDelay = getgenv().RapidFireDelay or 0.05
    RapidFireConnection = RunService.Heartbeat:Connect(function()
        if not getgenv().RapidFireEnabled then StopRapidFire() return end
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local t = tick()
            if t - RapidFireLastFireTime >= fireDelay then
                FireGun()
                RapidFireLastFireTime = t
            end
        end
    end)
end

local function StopRapidFire()
    if RapidFireConnection then
        RapidFireConnection:Disconnect()
        RapidFireConnection = nil
    end
    RapidFireRunning = false
    print("🔫 Rapid Fire DISABLED")
end

