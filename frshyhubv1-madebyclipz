-- RAPID FIRE + SUPER FAST SHOOT
-- *** MODIFIED: 30-shot burst + clean toggle ***
-- ============================================

local RapidFireRunning = false
local RapidFireConnection = nil
local RapidFireLastFireTime = 0
local RapidFireBursting = false

local SuperFastRunning = false
local SuperFastConnection = nil

-- How many shots to fire per burst when delay is 0
local RAPID_FIRE_BURST_COUNT = 30

local function FireGunOnce()
    local mousePos = UserInputService:GetMouseLocation()
    VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, true, game, 0)
    VirtualInputManager:SendMouseButtonEvent(mousePos.X, mousePos.Y, 0, false, game, 0)
end

local function FireGun()
    pcall(FireGunOnce)
end

local function FireBurst(count)
    if RapidFireBursting then return end
    RapidFireBursting = true
    for i = 1, count do
        FireGunOnce()
    end
    RapidFireBursting = false
end

local function StartRapidFire()
    if RapidFireRunning then return end
    if not getgenv().RapidFireEnabled then return end
    RapidFireRunning = true
    RapidFireLastFireTime = 0
    RapidFireBursting = false
    local fireDelay = getgenv().RapidFireDelay or 0
    print("🔫 Rapid Fire ENABLED (delay: " .. math.floor(fireDelay * 1000) .. "ms, burst: " .. RAPID_FIRE_BURST_COUNT .. ")")
    RapidFireConnection = Track(RunService.Heartbeat:Connect(function()
        if not RapidFireRunning then return end
        if not getgenv().RapidFireEnabled then StopRapidFire() return end
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            if fireDelay <= 0 then
                FireBurst(RAPID_FIRE_BURST_COUNT)
            else
                local t = tick()
                if t - RapidFireLastFireTime >= fireDelay then
                    FireBurst(RAPID_FIRE_BURST_COUNT)
                    RapidFireLastFireTime = t
                end
            end
        end
    end))
end

local function StopRapidFire()
    RapidFireRunning = false
    RapidFireBursting = false
    if RapidFireConnection then
        RapidFireConnection:Disconnect()
        RapidFireConnection = nil
    end
    print("🔫 Rapid Fire DISABLED")
end

local function StartSuperFastShoot()
    if SuperFastRunning then return end
    if not getgenv().SuperFastShootEnabled then return end
    SuperFastRunning = true
    print("⚡ Super Fast Shoot ENABLED (every frame)")
    SuperFastConnection = Track(RunService.RenderStepped:Connect(function()
        if not SuperFastRunning then return end
        if not getgenv().SuperFastShootEnabled then StopSuperFastShoot() return end
        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            FireGun()
        end
    end))
end

local function StopSuperFastShoot()
    SuperFastRunning = false
    if SuperFastConnection then
        SuperFastConnection:Disconnect()
        SuperFastConnection = nil
    end
    print("⚡ Super Fast Shoot DISABLED")
end

