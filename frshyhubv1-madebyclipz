-- ============================================
-- KEYBIND HANDLER (FIXED)
-- ============================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    -- KEY FIX: Allow keybind capture even when gameProcessed is true
    if gameProcessed and not WaitingForKeybind then return end
    if gameProcessed and WaitingForKeybind and input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    
    -- GUI Toggle
    if input.KeyCode == Enum.KeyCode.RightShift then
        GuiVisible = not GuiVisible
        if MainFrame then MainFrame.Visible = GuiVisible end
        return
    end
    
    -- Keybind waiting
    if WaitingForKeybind and input.KeyCode ~= Enum.KeyCode.Unknown then
        local key = input.KeyCode
        local action = WaitingForKeybindAction
        local button = WaitingForKeybindButton
        
        if key == Enum.KeyCode.RightShift then
            print("❌ Cannot bind Right Shift")
            if button then
                local displayName = action:gsub("Toggle", ""):gsub("TeleportToTarget", "Teleport"):gsub("BringTarget", "Bring"):gsub("RapidFire", "Rapid Fire")
                button.Text = displayName .. ": " .. (Keybinds[action] and KeyCodeToString(Keybinds[action]) or "None")
                button.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            end
            WaitingForKeybind = false
            WaitingForKeybindAction = nil
            WaitingForKeybindButton = nil
            return
        end
        
        Keybinds[action] = key
        Settings["Keybind_" .. action] = KeyCodeToString(key)
        SaveSettings()
        
        if button then
            local displayName = action:gsub("Toggle", ""):gsub("TeleportToTarget", "Teleport"):gsub("BringTarget", "Bring"):gsub("RapidFire", "Rapid Fire")
            button.Text = displayName .. ": " .. KeyCodeToString(key)
            button.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        end
        
        print("✅ Bound " .. action .. " to " .. KeyCodeToString(key))
        if SaveStatusLabel then
            SaveStatusLabel.Text = "✅ Bound " .. action .. " to " .. KeyCodeToString(key)
            SaveStatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            SaveStatusLabel.Visible = true
            task.delay(2, function() if SaveStatusLabel then SaveStatusLabel.Visible = false end end)
        end
        
        WaitingForKeybind = false
        WaitingForKeybindAction = nil
        WaitingForKeybindButton = nil
        return
    end
    
    -- Toggle Aimbot
    if Keybinds.ToggleAimbot and input.KeyCode == Keybinds.ToggleAimbot and not KeybindDebounce.ToggleAimbot then
        KeybindDebounce.ToggleAimbot = true
        ToggleAimbot()
        task.delay(0.2, function() KeybindDebounce.ToggleAimbot = false end)
        return
    end
    
    -- Toggle Fly
    if Keybinds.ToggleFly and input.KeyCode == Keybinds.ToggleFly and not KeybindDebounce.ToggleFly then
        KeybindDebounce.ToggleFly = true
        ToggleFly()
        task.delay(0.2, function() KeybindDebounce.ToggleFly = false end)
        return
    end
    
    -- Toggle Noclip
    if Keybinds.ToggleNoclip and input.KeyCode == Keybinds.ToggleNoclip and not KeybindDebounce.ToggleNoclip then
        KeybindDebounce.ToggleNoclip = true
        ToggleNoclip()
        task.delay(0.2, function() KeybindDebounce.ToggleNoclip = false end)
        return
    end
    
    -- Toggle ESP
    if Keybinds.ToggleESP and input.KeyCode == Keybinds.ToggleESP and not KeybindDebounce.ToggleESP then
        KeybindDebounce.ToggleESP = true
        ToggleESP()
        task.delay(0.2, function() KeybindDebounce.ToggleESP = false end)
        return
    end
    
    -- Toggle Rapid Fire
    if Keybinds.ToggleRapidFire and input.KeyCode == Keybinds.ToggleRapidFire and not KeybindDebounce.ToggleRapidFire then
        KeybindDebounce.ToggleRapidFire = true
        ToggleRapidFire()
        task.delay(0.2, function() KeybindDebounce.ToggleRapidFire = false end)
        return
    end
    
    -- Teleport to target
    if Keybinds.TeleportToTarget and input.KeyCode == Keybinds.TeleportToTarget and lockedTarget and not KeybindDebounce.TeleportToTarget then
        KeybindDebounce.TeleportToTarget = true
        TeleportToPlayer(lockedTarget)
        task.delay(0.3, function() KeybindDebounce.TeleportToTarget = false end)
        return
    end
    
    -- Bring target
    if Keybinds.BringTarget and input.KeyCode == Keybinds.BringTarget and lockedTarget and not KeybindDebounce.BringTarget then
        KeybindDebounce.BringTarget = true
        BringPlayer(lockedTarget)
        task.delay(0.3, function() KeybindDebounce.BringTarget = false end)
        return
    end
end)

