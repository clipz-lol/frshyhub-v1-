local function LoadFromSlot(slotNumber)
    if slotNumber < 1 or slotNumber > 10 then return false end
    local success, data = pcall(function() return readfile(GetSlotFilename(slotNumber)) end)
    if not success or not data then return false end
    local decoded = HttpService:JSONDecode(data)
    if not decoded then return false end
    
    for key, value in pairs(decoded) do
        if key == "ProtectedPlayers" then
            ProtectedPlayers = value or {}
            ProtectedPlayersSet = {}
            for _, name in ipairs(ProtectedPlayers) do ProtectedPlayersSet[name] = true end
            Settings.ProtectedPlayers = ProtectedPlayers
        elseif key == "ESPCustomColor" then Settings.ESPCustomColor = value
        elseif key == "FOVColor" then Settings.FOVColor = value
        elseif string.match(key, "Keybind_") then Settings[key] = value
        else
            getgenv()[key] = value
            Settings[key] = value
        end
    end
    
    Keybinds.ToggleAimbot = StringToKeyCode(Settings.Keybind_ToggleAimbot)
    Keybinds.ToggleFly = StringToKeyCode(Settings.Keybind_ToggleFly)
    Keybinds.ToggleNoclip = StringToKeyCode(Settings.Keybind_ToggleNoclip)
    Keybinds.TeleportToTarget = StringToKeyCode(Settings.Keybind_TeleportToTarget)
    Keybinds.BringTarget = StringToKeyCode(Settings.Keybind_BringTarget)
    Keybinds.ToggleRapidFire = StringToKeyCode(Settings.Keybind_ToggleRapidFire)
    Keybinds.ToggleESP = StringToKeyCode(Settings.Keybind_ToggleESP)
    
    SaveSettings()
    if UpdateFOVCircle then UpdateFOVCircle() end
    if UpdateKeybindLabels then UpdateKeybindLabels() end
    if UpdateRapidFireButton then UpdateRapidFireButton() end
    if UpdateESPToggle then UpdateESPToggle() end
    if UpdateAllTabButtons then UpdateAllTabButtons() end
    return true
end

local function GetSlotInfo(slotNumber)
    local success, data = pcall(function() return readfile(GetSlotFilename(slotNumber)) end)
    if success and data then
        local decoded = HttpService:JSONDecode(data)
        if decoded then
            local name = GetSlotName(slotNumber)
            return name .. " | FOV:" .. (decoded.AimFOV or "?") ..
                   " | Sm:" .. tostring(decoded.Smoothness or 0) ..
                   " | ESP:" .. (decoded.ESPEnabled and "ON" or "OFF")
