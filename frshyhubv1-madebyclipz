-- SHOOT THROUGH WALLS (WALLBANG)
-- ============================================

local WallBangActive = false
local WallBangOriginalStates = {}

local function EnableWallBang()
    if WallBangActive then return end
    WallBangActive = true
    WallBangOriginalStates = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local isCharacterPart = false
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and obj:IsDescendantOf(player.Character) then
                    isCharacterPart = true
                    break
                end
            end
            if not isCharacterPart then
                WallBangOriginalStates[obj] = obj.CanQuery
                obj.CanQuery = false
            end
        end
    end
    print("🔫 WallBang ENABLED")
end

local function DisableWallBang()
    if not WallBangActive then return end
    WallBangActive = false
    for obj, originalState in pairs(WallBangOriginalStates) do
        pcall(function()
            if obj and obj.Parent then
                obj.CanQuery = originalState
            end
        end)
    end
    WallBangOriginalStates = {}
    print("🔫 WallBang DISABLED")
end

local function SetWallBang(state)
    if state then
        if not WallBangActive then EnableWallBang() end
        getgenv().WallBangEnabled = true
    else
        if WallBangActive then DisableWallBang() end
        getgenv().WallBangEnabled = false
    end
    Settings.WallBangEnabled = getgenv().WallBangEnabled
    SaveSettings()
    UpdateAllTabButtons()
end

local WallBangConnection = nil
local function StartWallBangAutoRefresh()
    if WallBangConnection then return end
    WallBangConnection = Track(Workspace.DescendantAdded:Connect(function(obj)
        if WallBangActive and obj:IsA("BasePart") then
            local isCharacterPart = false
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and obj:IsDescendantOf(player.Character) then
                    isCharacterPart = true
                    break
                end
            end
            if not isCharacterPart then
                WallBangOriginalStates[obj] = obj.CanQuery
                obj.CanQuery = false
            end
        end
    end))
end
StartWallBangAutoRefresh()

