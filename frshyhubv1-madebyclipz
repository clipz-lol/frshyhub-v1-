local ProtectedPlayers = Settings.ProtectedPlayers or {}
local ProtectedPlayersSet = {}

local function RebuildProtectedSet()
    ProtectedPlayersSet = {}
    for _, entry in ipairs(ProtectedPlayers) do
        if type(entry) == "table" then
            if entry.Name then ProtectedPlayersSet[entry.Name] = true end
            if entry.UserId then ProtectedPlayersSet[entry.UserId] = true end
        else
            ProtectedPlayersSet[entry] = true
        end
    end
end
RebuildProtectedSet()

local PlayerButtons = {}
local TeleportButtons = {}
local BringButtons = {}
local FriendSearchQuery = ""
local TeleportSearchQuery = ""
local BringSearchQuery = ""

local function AddProtectedPlayer(player)
    if not player or player == LocalPlayer then return false end
    local name = player.Name
    local userId = player.UserId
    if ProtectedPlayersSet[name] or ProtectedPlayersSet[userId] then return false end
    table.insert(ProtectedPlayers, {Name = name, UserId = userId})
    ProtectedPlayersSet[name] = true
    ProtectedPlayersSet[userId] = true
    Settings.ProtectedPlayers = ProtectedPlayers
    SaveSettings()
    return true
end

local function RemoveProtectedPlayer(player)
    if not player then return false end
    local name = player.Name
    local userId = player.UserId
    local removed = false
    for i = #ProtectedPlayers, 1, -1 do
        local entry = ProtectedPlayers[i]
        local match = false
        if type(entry) == "table" then
            match = (entry.Name == name) or (entry.UserId == userId)
        else
            match = (entry == name)
        end
        if match then
            table.remove(ProtectedPlayers, i)
            removed = true
        end
    end
    if removed then
        ProtectedPlayersSet[name] = nil
        ProtectedPlayersSet[userId] = nil
        Settings.ProtectedPlayers = ProtectedPlayers
        SaveSettings()
    end
    return removed
end

local function IsProtected(player)
    if not player then return false end
    if player == LocalPlayer then return true end
    return ProtectedPlayersSet[player.Name] == true
        or ProtectedPlayersSet[player.UserId] == true
end

