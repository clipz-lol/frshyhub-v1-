        Label.Parent = Container
        local Input = Instance.new("TextBox")
        Input.Size = UDim2.new(1, 0, 0, 22)
        Input.Position = UDim2.new(0, 0, 0, 20)
        Input.Text = table.concat(getter(), ",")
        Input.TextColor3 = TC(Theme.AccentColor)
        Input.BackgroundColor3 = TC(Theme.PanelColor)
        Input.Font = Enum.Font.Gotham
        Input.TextSize = 13
        Input.Parent = Container
        Input.FocusLost:Connect(function()
            local parsed = ParseColorInput(Input.Text, getter())
            setter(parsed)
            Label.Text = labelText .. ": " .. table.concat(parsed, ",")
            Input.Text = table.concat(parsed, ",")
            SaveSettings()
            if ApplyThemeToGUI then ApplyThemeToGUI() end
        end)
        return Input
    end

